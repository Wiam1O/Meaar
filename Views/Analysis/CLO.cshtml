@model List<Meaar5.Models.CourseCLO>

@{
    ViewData["Title"] = "CLO";
}

<link rel="stylesheet" href="~/css/clo.css" />

<div class="clo-page">

    <h2 class="clo-main-title">Course Learning Outcomes</h2>

    <!-- ================= ADD CLO================= -->
    <div class="clo-card">

        <div class="clo-title">Add CLO</div>

        <form asp-action="Save" method="post">
            <input type="hidden" name="courseId" value="@ViewBag.CourseId" />

            <table class="clo-table">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th>Type</th>
                    </tr>
                </thead>

                <tbody id="cloRows">
                    <tr>
                        <td>
                            <input name="clos[0].Description" class="form-control" placeholder="Write CLO..." />
                        </td>

                        <td>
                            <select name="clos[0].ProgramAlignment" class="form-control">
                                <option value="">Select</option>
                                <option>K1</option>
                                <option>K2</option>
                                <option>K3</option>

                                <option>S1</option>
                                <option>S2</option>
                                <option>S3</option>

                                <option>V1</option>
                                <option>V2</option>
                                <option>V3</option>

                            </select>
                        </td>
                    </tr>
                </tbody>
            </table>

            <br />
            <div class="action">
            <button type="button" class="add-row-btn" onclick="addRow()"> Add CLOs</button>
            <button type="submit" class="save-btn"> Save </button>
            </div>
        </form>
    </div>


    <!-- ================= SAVED CLOs  ================= -->
    <div class="clo-card">

        <div class="clo-title">The CLOs For the Course:</div>

        @if (!Model.Any())
        {
            <p>No CLOs Added</p>
        }
        else
        {
            foreach (var item in Model)
            {
                <div class="clo-item">

                    <div>
                        <strong>@item.CLO.Description</strong><br />
                        <span class="alignment-badge">
                            @item.CLO.Type
                            </span>
                    </div>

                    <form method="post" asp-action="Delete">
                        <input type="hidden" name="id" value="@item.CourseCLOId" />
                        <input type="hidden" name="courseId" value="@ViewBag.CourseId" />
                        <button class="delete-btn"> Delete </button>
                    </form>

                </div>
            }
        }

    </div>

</div>


<script>
    let index = 1;

    function addRow() {
        let row = `
        <tr>
            <td>
                <input name="clos[${index}].Description" class="form-control" />
            </td>

            <td>
                <select name="clos[${index}].ProgramAlignment" class="form-control">
                    <option value="">Select</option>
                    <option>K1</option>
                    <option>K2</option>
                    <option>S1</option>
                    <option>S2</option>
                    <option>V1</option>
                </select>
            </td>
        </tr>`;

        document.getElementById("cloRows").insertAdjacentHTML("beforeend", row);
        index++;
    }
</script>